<?xml version="1.0" encoding="utf-8"?>

<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>GHIElectronics.TinyCLR.Drivers.Worldsemi.WS2812</id>
    <version>3.0.1.1000</version>
    <authors>GHI Electronics, LLC</authors>
    <owners>GHI Electronics, LLC</owners>
    <projectUrl>https://ghielectronics.com/</projectUrl>
    <iconUrl>http://files.ghielectronics.com/downloads/Logos/GHIElectronicsTinyCLRNuGet.png</iconUrl>
    <licenseUrl>http://files.ghielectronics.com/downloads/TinyCLR/License.txt</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>Neopixel WS2812 driver for TinyCLR OS.</description>
    <copyright>Copyright GHI Electronics, LLC 2026</copyright>
    <tags>TinyCLR TinyCLROS Neopixel WS2812</tags>
    <dependencies>
      <dependency id="GHIElectronics.TinyCLR.Core" version="3.0.1.1000" />
      <dependency id="GHIElectronics.TinyCLR.Devices.Gpio" version="3.0.1.1000" />
      <dependency id="GHIElectronics.TinyCLR.Devices.Signals" version="3.0.1.1000" />
      <dependency id="GHIElectronics.TinyCLR.Native" version="3.0.1.1000" />
    </dependencies>
  </metadata>
  <files>
    <!-- lib/net48/ : TinyCLR-IMPL DLL (auto-referenced for compile). -->
    <file src="$TargetDir$GHIElectronics.TinyCLR.Drivers.Worldsemi.WS2812.dll" target="lib\net48" />



    <!-- Consumer-side props. -->
    <file src="$ProjectDir$GHIElectronics.TinyCLR.Drivers.Worldsemi.WS2812.props" target="build\net48" />
  </files>
</package>